# Salin berkas ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.example .env
# Tanpa .env, docker compose up akan LANGSUNG GAGAL karena semua variabel
# ditandai ${VAR:?pesan} di docker-compose.yml.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=uts_mbd
# 3 digit terakhir NIM 1247050122 -> 122 -> port 22122
POSTGRES_PORT=22122

PGADMIN_DEFAULT_EMAIL=nama@example.com
PGADMIN_DEFAULT_PASSWORD=
# 3 digit terakhir NIM -> 122 -> port 44122
PGADMIN_PORT=44122
